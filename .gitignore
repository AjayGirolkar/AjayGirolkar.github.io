.DS_Store

# Secrets — never commit these
.env
credentials.json
token.json
payment-gateway/keys.js

# Temporary processing files
.tmp/*
!.tmp/.gitkeep

# Design-canvas build output — regenerated by gen.py / build_canvas.py
design-canvas/*/out/
__pycache__/
*.pyc

# App screenshots — only the web-optimised webp are served; PNG sources
# and proof sheets stay local
assets/app-screenshots/**/*.png

# Design-canvas scratch — raw source photos and grading experiments
design-canvas/*/src/
design-canvas/*/_cand.*
design-canvas/*/_graded.*
design-canvas/*/_all.png
design-canvas/*/_sheet.png

# Pages build output assembled by .github/workflows/pages.yml
_site/

# PDF case-study layout previews (regenerate with --png)
assets/portfolio-pdf/_preview/
